@model PaginatedAllMembersDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    Model.PageSize = ViewBag.PageSize;
}
<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Members</h1>
        <a asp-controller="Members" asp-action="AddMember" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Member</a>
    </div>

    <form class="toolbar" asp-controller="Members" asp-action="Index" method="get">
        <input name="searchByName" type="search" class="form-control form-control-sm" style="max-width: 280px;" placeholder="Search by name..." value="@ViewBag.SearchByName" />
        <select name="searchByStatus" class="form-select form-select-sm" style="max-width: 160px;">
            <option value="">All Status</option>
            @if(ViewBag.SearchByStatus == "Active")
            {
                <option selected="selected" value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            }
            else if (ViewBag.SearchByStatus == "Inactive")
            {
                <option value="Active">Active</option>
                <option selected="selected" value="Inactive">Inactive</option>
            }
            else
            {
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            }
            
            
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
        <a asp-controller="Members" asp-action="Index">Clear Search</a>
    </form>

    <div class="panel">
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach(var member in Model.Items)
                        {
                            <tr>
                                <td><img class="table-photo-thumb" src="@member.MemberImage" alt="Photo" /></td>
                                <td>@member.Name</td>
                                <td>@member.Email</td>
                                <td>@member.Phone</td>
                                <td><span class="badge badge-status-active">@member.Status</span></td>
                                <td class="action-icons">
                                    <a href="javascript:void(0)" title="View" data-bs-toggle="modal" data-bs-target="#@member?.Id"><i class="bi bi-eye"></i></a>
                                    <a asp-controller="Members" asp-action="EditMember" asp-route-id="@member.Id" ><i class="bi bi-pencil"></i></a>
                                    <a asp-controller="Members" asp-action="DeleteMember" asp-route-id="@member.Id" class="btn-delete text-danger" ><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Books pagination">
            <ul class="pagination pagination-sm justify-content-end">
                @*IMP*@
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a asp-controller="Members"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchByName="@ViewBag.SearchByName"
                           asp-route-searchByStatus="@ViewBag.SearchByStatus"
                           class="page-link">
                            Previous
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Previous</span>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (Model.CurrentPage == i)
                    {
                        <li class="page-item active">
                            <a class="page-link"
                               href="/Members?page=@i&pageSize=@Model.PageSize&searchBy=@ViewBag.SearchByName&searchByStatus=@ViewBag.searchbyStatus">@i</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="/Members?page=@i&pageSize=@Model.PageSize&searchByName=@ViewBag.SearchByName&searchByStatus=@ViewBag.SearchByStatus">@i</a>
                        </li>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a asp-controller="Members"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchByName="@ViewBag.SearchByName"
                           asp-route-searchByStatus="@ViewBag.SearchByStatus"
                           class="page-link">
                            Next
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Next</span>
                    </li>
                }
            </ul>
        </nav>
    }
</main>


<!-- ================= Member View Modals ================= -->
@foreach(var member in Model.Items)
{
    <div class="modal fade" id="@member.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-circle"></i> @member.Name</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-3 text-center">
                            <img class="table-photo-thumb" style="width:80px;height:80px;" src="@member.MemberImage" alt="Photo" />
                        </div>
                        <div class="col-md-9">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@member.Email</dd>
                                <dt class="col-sm-4">Phone</dt>
                                <dd class="col-sm-8">@member.Phone</dd>
                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8"><span class="badge badge-status-active">@member.Status</span></dd>
                                <dt class="col-sm-4">Address</dt>
                                <dd class="col-sm-8">@member.Address</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="form-section-title"><i class="bi bi-book"></i> Books Issued</div>

                    @if(member.BookTransactions.Count() > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Book Title</th>
                                        <th>Issue Date</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var book in member.BookTransactions)
                                    {
                                        <tr>
                                            <td>@book.BookTitle</td>
                                            <td>@book.IssueDate</td>
                                            <td>@book.ReturnDate</td>
                                            <td><span class="badge badge-status-active">8 days left</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted-sm mb-0">No book has assigned to this member yet.</p>
                    }

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <a asp-controller="Members" asp-action="EditMember" asp-route-id="@member.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
                </div>
            </div>
        </div>
    </div>
}