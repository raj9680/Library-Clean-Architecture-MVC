@model AllMembersDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Add / Edit Member</h1>
    </div>

    <div class="panel">
        <div class="panel-body">
            <form asp-controller="Members" asp-action="EditMember" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Amanpreet Kaur" />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="e.g. name@example.com" />
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for=Phone class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g. +91 98765 43210" />
                        <span asp-validation-for="Phone"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            @if(Model.Status == "Active")
                            {
                                <option selected="selected" value="Active" >Active</option>
                                <option value="Inactive">Inactive</option>
                            } else if(Model.Status == "Inactive")
                            {
                                <option value="Active">Active</option>
                                <option selected="selected" value="Inactive">Inactive</option>
                            }
                            else
                            {
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            }
                            
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" placeholder="e.g. Ludhiana, Punjab" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Photo</label>
                        <input type="file" class="form-control" accept="image/*" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                    <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
                </div>
            </form>
        </div>
    </div>
</main>