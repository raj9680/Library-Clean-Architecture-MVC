@model Library.Application.DTOs.DashboardDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Dashboard</h1>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-book"></i> Total Books</div>
                <div class="stat-value">@Model.TotalBooks</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-people"></i> Total Members</div>
                <div class="stat-value">@Model.TotalMembers</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-box-arrow-right"></i> Issued Books</div>
                <div class="stat-value">@Model.IssuedBooks</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-check2-square"></i> Available Books</div>
                <div class="stat-value">@Model.AvailableBooks</div>
            </div>
        </div>
    </div>

    <!-- Recently Added Books -->
    <div class="panel">
        <div class="panel-header"><i class="bi bi-clock-history"></i> Recently Added Books</div>
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>ISBN</th>
                            <th>Category</th>
                            <th>Author</th>
                            <th>Added On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentlyAddedBooks)
                        {
                            <tr>
                                <td>@item.BookTitle</td>
                                <td>@item.ISBN</td>
                                <td>@item.Category</td>
                                <td>@item.Author</td>
                                <td>@item.AddedOn?.ToString("dd-MM-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recently Issued Books -->
    <div class="panel">
        <div class="panel-header"><i class="bi bi-arrow-left-right"></i> Recently Issued Books</div>
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Book Title</th>
                            <th>Member</th>
                            <th>Issue Date</th>
                            <th>Due Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentlyIssuedBooks)
                        {
                            <tr>
                                <td>@item.BookTitle</td>
                                <td>@item.Member</td>
                                <td>@item.IssueDate?.ToString("dd-MM-yyyy")</td>
                                <td>@item.DueDate?.ToString("dd-MM-yyyy")</td>
                                <td><span class="badge badge-status-active">Issued</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>