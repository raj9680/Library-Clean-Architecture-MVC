@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Dashboard</h1>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-book"></i> Total Books</div>
                <div class="stat-value">1,248</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-people"></i> Total Members</div>
                <div class="stat-value">356</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-box-arrow-right"></i> Issued Books</div>
                <div class="stat-value">87</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-check2-square"></i> Available Books</div>
                <div class="stat-value">1,161</div>
            </div>
        </div>
    </div>

    <!-- Recently Added Books -->
    <div class="panel">
        <div class="panel-header"><i class="bi bi-clock-history"></i> Recently Added Books</div>
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>ISBN</th>
                            <th>Category</th>
                            <th>Author</th>
                            <th>Added On</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>The Silent Observer</td>
                            <td>978-0-123456-01-1</td>
                            <td>Fiction</td>
                            <td>J. Harmon</td>
                            <td>2026-07-05</td>
                        </tr>
                        <tr>
                            <td>Principles of Database Design</td>
                            <td>978-0-123456-02-2</td>
                            <td>Computer Science</td>
                            <td>R. Nair</td>
                            <td>2026-07-04</td>
                        </tr>
                        <tr>
                            <td>A History of Modern Punjab</td>
                            <td>978-0-123456-03-3</td>
                            <td>History</td>
                            <td>S. Gill</td>
                            <td>2026-07-02</td>
                        </tr>
                        <tr>
                            <td>Introduction to Algorithms</td>
                            <td>978-0-123456-04-4</td>
                            <td>Computer Science</td>
                            <td>T. Cormen</td>
                            <td>2026-06-29</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recently Issued Books -->
    <div class="panel">
        <div class="panel-header"><i class="bi bi-arrow-left-right"></i> Recently Issued Books</div>
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Book Title</th>
                            <th>Member</th>
                            <th>Issue Date</th>
                            <th>Due Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>The Silent Observer</td>
                            <td>Amanpreet Kaur</td>
                            <td>2026-07-01</td>
                            <td>2026-07-15</td>
                            <td><span class="badge badge-status-active">Issued</span></td>
                        </tr>
                        <tr>
                            <td>Introduction to Algorithms</td>
                            <td>Rohit Sharma</td>
                            <td>2026-06-28</td>
                            <td>2026-07-12</td>
                            <td><span class="badge badge-status-active">Issued</span></td>
                        </tr>
                        <tr>
                            <td>Principles of Database Design</td>
                            <td>Simran Kaur</td>
                            <td>2026-06-25</td>
                            <td>2026-07-09</td>
                            <td><span class="badge badge-status-inactive">Overdue</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>