@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Authors</h1>
        <a asp-controller="Authors" asp-action="AddAuthor" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Author</a>
    </div>

    <div class="toolbar">
        <input type="search" class="form-control form-control-sm" style="max-width: 280px;" placeholder="Search by author name..." />
        <button type="button" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
    </div>

    <div class="panel">
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Country</th>
                            <th>Books Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr>
                            <td>J. Harmon</td>
                            <td>United Kingdom</td>
                            <td>5</td>
                            <td class="action-icons">
                                <a href="#" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-controller="Authors" asp-action="EditAuthor" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-controller="Authors" asp-action="DeleteAuthor" class="btn-delete text-danger" data-name="J. Harmon" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <nav aria-label="Authors pagination">
        <ul class="pagination pagination-sm justify-content-end">
            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">Next</a></li>
        </ul>
    </nav>
</main>