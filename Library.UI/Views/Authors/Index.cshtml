@model PaginatedAllAuthorsDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main-content" id="mainContent">

    <div class="page-header">
        <h1>Authors</h1>

        <a asp-controller="Authors"
           asp-action="AddAuthor"
           class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Add Author
        </a>
    </div>

    <form class="toolbar"
          asp-controller="Authors"
          asp-action="Index"
          method="get">

        <input name="searchByName"
               type="search"
               class="form-control form-control-sm"
               style="max-width: 280px;"
               placeholder="Search by author name..."
               value="@Context.Request.Query["searchByName"]" />

        <button type="submit"
                class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-search"></i> Search
        </button>
    </form>


    @* ================= DELETE RESULT MESSAGE ================= *@

    @if (TempData["DeletedResult"] != null)
    {
        int deletedResult = Convert.ToInt32(TempData["DeletedResult"]);

        if (deletedResult == 457)
        {
            <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
                <strong>Unable to delete author.</strong>
                This author cannot be deleted because one or more books are associated with them.

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }
        else if (deletedResult == 1)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <strong>Author deleted successfully.</strong>
                The author has been removed successfully.

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }
        else if (deletedResult == 0)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <strong>Something went wrong.</strong>
                The author could not be deleted. Please try again.

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }
    }


    @* ================= AUTHORS TABLE ================= *@

    <div class="panel">
        <div class="panel-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Country</th>
                            <th>Books Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>@item.Name</td>

                                <td>@item.Country</td>

                                <td>@item.TotalBooks</td>

                                <td class="action-icons">

                                    <a href="#"
                                       title="View"
                                       data-bs-toggle="modal"
                                       data-bs-target="#@item.Id">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-controller="Authors"
                                       asp-action="EditAuthor"
                                       asp-route-id="@item.Id"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-controller="Authors"
                                       asp-action="DeleteAuthor"
                                       asp-route-id="@item.Id"
                                       class="btn-delete text-danger"
                                       title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>


    @* ================= PAGINATION ================= *@

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Authors pagination">

            <ul class="pagination pagination-sm justify-content-end">

                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">

                        <a asp-controller="Authors"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchByName="@Context.Request.Query["searchByName"]"
                           class="page-link">
                            Previous
                        </a>

                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Previous</span>
                    </li>
                }


                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (Model.CurrentPage == i)
                    {
                        <li class="page-item active">

                            <a asp-controller="Authors"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchByName="@Context.Request.Query["searchByName"]"
                               class="page-link">
                                @i
                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="page-item">

                            <a asp-controller="Authors"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchByName="@Context.Request.Query["searchByName"]"
                               class="page-link">
                                @i
                            </a>

                        </li>
                    }
                }


                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">

                        <a asp-controller="Authors"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchByName="@Context.Request.Query["searchByName"]"
                           class="page-link">
                            Next
                        </a>

                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Next</span>
                    </li>
                }

            </ul>

        </nav>
    }

</main>


@* ================= AUTHOR VIEW MODALS ================= *@

@foreach (var i in Model.Items)
{
    <div class="modal fade"
         id="@i.Id"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        <i class="bi bi-person-circle"></i> @i.Name
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-3 text-center">

                            <img class="table-photo-thumb"
                                 style="width:80px;height:80px;padding-top:12px;"
                                 src="~/img/writer-clipart-xl.png"
                                 alt="Photo" />

                        </div>

                        <div class="col-md-9">

                            <dl class="row mb-0">

                                <dt class="col-sm-4">Name</dt>
                                <dd class="col-sm-8">@i.Name</dd>

                                <dt class="col-sm-4">Country</dt>
                                <dd class="col-sm-8">@i.Country</dd>

                                <dt class="col-sm-4">Biography</dt>
                                <dd class="col-sm-8">@i.Biography</dd>

                            </dl>

                        </div>

                    </div>


                    <div class="form-section-title">
                        <i class="bi bi-book"></i> Books
                    </div>


                    <div class="table-responsive">

                        <table class="table table-sm mb-0">

                            <thead>

                                <tr>
                                    <th>Book Title</th>
                                    <th>Publisher</th>
                                    <th>Publish Date</th>
                                    <th>View</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var b in i.Books)
                                {
                                    <tr>

                                        <td>@b.BookTitle</td>

                                        <td>@b.Publisher</td>

                                        <td>
                                            @b.PublishDate?.ToString("dd-MM-yyyy")
                                        </td>

                                        <td>

                                            <span class="badge badge-status-active">

                                                <a href="/Books?searchBy=@b.BookTitle&searchByCategory=@b.CategoryId"
                                                   style="text-decoration: none;color: #fff !important;">
                                                    View Book
                                                </a>

                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <a asp-controller="Authors"
                       asp-action="EditAuthor"
                       asp-route-id="@i.Id"
                       class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>

                </div>

            </div>

        </div>

    </div>
}