@model AuthorDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Add / Edit Author</h1>
    </div>

    <div class="panel">
        <div class="panel-body">
            <form asp-controller="Authors" asp-action="EditAuthor" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. J. Harmon" />
                        <span asp-validation-for="Name"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CountryId" class="form-label">Category</label>
                        <select asp-for="CountryId" class="form-select">
                            @await Component.InvokeAsync("CountryDropdown")
                        </select>
                        <span asp-validation-for="CountryId"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Biography" class="form-label">Biography</label>
                        <textarea asp-for="Biography" class="form-control" rows="4" placeholder="Short biography of the author..."></textarea>
                        <span asp-validation-for="Biography"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                    <a asp-controller="Authors" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
                </div>
            </form>
        </div>
    </div>
</main>