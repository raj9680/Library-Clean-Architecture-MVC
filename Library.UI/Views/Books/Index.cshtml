@model Library.Application.DTOs.PaginatedAllBooksDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Books</h1>
        <a asp-controller="Books" asp-action="AddBook" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Book</a>
    </div>

    <form class="toolbar" asp-controller="Books" asp-action="Index" method="get">
        <input name="searchBy" value="@ViewBag.SearchBy" type="search" class="form-control form-control-sm" style="max-width: 280px;" placeholder="Search by title, ISBN or author" />

        <select name="searchByCategory" class="form-select form-select-sm" style="max-width: 180px;">
            @await Component.InvokeAsync("CategoryDropdown")
        </select>

        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search" style="margin-right:6px;"></i>Search</button>
        <a asp-controller="Books" asp-action="Index">Clear Search</a>
    </form>

    <div class="panel">
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Cover</th>
                            <th>Title</th>
                            <th>ISBN</th>
                            <th>Category</th>
                            <th>Author</th>
                            <th>Available Copies</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.Items)
                        {
                            <tr>
                                <td><img class="table-cover-thumb" src="@item?.BookURL" alt="Cover" /></td>
                                <td>@item?.BookTitle</td>
                                <td>@item?.ISBN</td>
                                <td>@item?.Category</td>
                                <td>@item?.Author</td>
                                <td>@item?.AvailableCopies</td>
                                <td class="action-icons">
                                    <a href="javascript:void(0)" title="View" data-bs-toggle="modal" data-bs-target="#@item?.BookId"><i class="bi bi-eye"></i></a>
                                    <a asp-controller="Books" asp-action="EditBook" asp-route-id="@item?.BookId" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-controller="Books" asp-action="DeleteBook" class="btn-delete text-danger" data-name="The Silent Observer" title="Delete"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if(Model.TotalPages > 1)
    {
        <nav aria-label="Books pagination">
            <ul class="pagination pagination-sm justify-content-end">
                @*IMP*@
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a asp-controller="Books"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchBy="@ViewBag.SearchBy"
                           asp-route-searchByCategory="@ViewBag.SearchByCategory"
                           class="page-link">
                            Previous
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Previous</span>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (Model.CurrentPage == i)
                    {
                        <li class="page-item active">
                            <a class="page-link"
                               href="/Books?page=@i&pageSize=@Model.PageSize&searchBy=@ViewBag.SearchBy&searchByCategory=@ViewBag.SearchByCategory">@i</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="/Books?page=@i&pageSize=@Model.PageSize&searchBy=@ViewBag.SearchBy&searchByCategory=@ViewBag.SearchByCategory">@i</a>
                        </li>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a asp-controller="Books"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchBy="@ViewBag.SearchBy"
                           asp-route-searchByCategory="@ViewBag.SearchByCategory"
                           class="page-link">
                            Next
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Next</span>
                    </li>
                }
            </ul>
        </nav>
    }
</main>

<!-- ================= Book View Modals ================= -->
<!-- Book 1: The Silent Observer -->
@foreach(var item in Model.Items)
{
<div class="modal fade" id="@item?.BookId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-book"></i> @item?.BookTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-3 text-center">
                            <img class="table-cover-thumb" style="width:100px;height:135px;" src="@item?.BookURL" alt="Cover" />
                    </div>
                    <div class="col-md-9">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">ISBN</dt>
                                <dd class="col-sm-8">@item?.ISBN</dd>
                            <dt class="col-sm-4">Category</dt>
                                <dd class="col-sm-8">@item?.Category</dd>
                            <dt class="col-sm-4">Author</dt>
                                <dd class="col-sm-8">@item?.Author</dd>
                            <dt class="col-sm-4">Publisher</dt>
                                <dd class="col-sm-8">@item?.Publisher</dd>
                            <dt class="col-sm-4">Publish Date</dt>
                                <dd class="col-sm-8">@item?.PublishDate?.ToString("dd-MM-yyyy")</dd>
                            <dt class="col-sm-4">Total Copies</dt>
                                <dd class="col-sm-8">@item?.TotalCopies</dd>
                            <dt class="col-sm-4">Available Copies</dt>
                                <dd class="col-sm-8">@item?.AvailableCopies</dd>
                            <dt class="col-sm-4">Shelf Number</dt>
                                <dd class="col-sm-8">@item?.ShelfNumber</dd>
                        </dl>
                    </div>
                    <div class="col-12">
                            <p class="text-muted-sm mb-0" style="text-align:center;">@item?.Description</p>
                    </div>
                </div>

                <div class="form-section-title"><i class="bi bi-people"></i> Issued To Members</div>
                   
                    @if(item?.AllBooksTransactionsDto.Count > 0)
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <select class="form-select member-select-dropdown" data-link-id="viewMemberLink1" style="max-width: 320px">
                                @foreach (var i in item.AllBooksTransactionsDto)
                                {
                                    if(i.ReturnDate == null || i.ReturnDate == DateTime.MinValue)
                                    {
                                        <option data-member-hash="member-@i.TMemberId">@i.Member - Issued @i.ReturnDate?.ToString("dd-MM-yyyy")</option>
                                    } else
                                    {
                                        <option data-member-hash="member-@i.TMemberId">@i.Member - Returned @i.ReturnDate?.ToString("dd-MM-yyyy")</option>
                                    }
                                }
                            </select>

                            <a asp-controller="Members" asp-action="Index" id="member-2" class="btn btn-outline-secondary text-nowrap">
                                <i class="bi bi-box-arrow-up-right"></i> View Member
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted-sm mb-0">This book has not been assigned to any members yet.</p>
                    }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <a href="book-form.html" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
            </div>
        </div>
    </div>
</div>
}
