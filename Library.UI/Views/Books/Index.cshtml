@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Books</h1>
        <a asp-controller="Books" asp-action="AddBook" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Book</a>
    </div>

    <div class="toolbar">
        <input type="search" class="form-control form-control-sm" style="max-width: 280px;" placeholder="Search by title, ISBN or author..." />
        <select class="form-select form-select-sm" style="max-width: 180px;">
            <option value="">All Categories</option>
            <option value="fiction">Fiction</option>
            <option value="cs">Computer Science</option>
            <option value="history">History</option>
        </select>
        <button type="button" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
    </div>

    <div class="panel">
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Cover</th>
                            <th>Title</th>
                            <th>ISBN</th>
                            <th>Category</th>
                            <th>Author</th>
                            <th>Available Copies</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr>
                            <td><img class="table-cover-thumb" src="https://via.placeholder.com/40x54?text=Book" alt="Cover" /></td>
                            <td>The Silent Observer</td>
                            <td>978-0-123456-01-1</td>
                            <td>Fiction</td>
                            <td>J. Harmon</td>
                            <td>4</td>
                            <td class="action-icons">
                                <a href="#" title="View" data-bs-toggle="modal" data-bs-target="#bookViewModal1"><i class="bi bi-eye"></i></a>
                                <a asp-controller="Books" asp-action="EditBook" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-controller="Books" asp-action="DeleteBook" class="btn-delete text-danger" data-name="The Silent Observer" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td><img class="table-cover-thumb" src="https://via.placeholder.com/40x54?text=Book" alt="Cover" /></td>
                            <td>The Silent Observer</td>
                            <td>978-0-123456-01-1</td>
                            <td>Fiction</td>
                            <td>J. Harmon</td>
                            <td>4</td>
                            <td class="action-icons">
                                <a href="#" title="View" data-bs-toggle="modal" data-bs-target="#bookViewModal1"><i class="bi bi-eye"></i></a>
                                <a asp-controller="Books" asp-action="EditBook" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-controller="Books" asp-action="DeleteBook" class="btn-delete text-danger" data-name="The Silent Observer" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td><img class="table-cover-thumb" src="https://via.placeholder.com/40x54?text=Book" alt="Cover" /></td>
                            <td>The Silent Observer</td>
                            <td>978-0-123456-01-1</td>
                            <td>Fiction</td>
                            <td>J. Harmon</td>
                            <td>4</td>
                            <td class="action-icons">
                                <a href="#" title="View" data-bs-toggle="modal" data-bs-target="#bookViewModal1"><i class="bi bi-eye"></i></a>
                                <a asp-controller="Books" asp-action="EditBook" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-controller="Books" asp-action="DeleteBook" class="btn-delete text-danger" data-name="The Silent Observer" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <nav aria-label="Books pagination">
        <ul class="pagination pagination-sm justify-content-end">
            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">Next</a></li>
        </ul>
    </nav>
</main>

<!-- ================= Book View Modals ================= -->
<!-- Book 1: The Silent Observer -->
<div class="modal fade" id="bookViewModal1" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-book"></i> The Silent Observer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-3 text-center">
                        <img class="table-cover-thumb" style="width:100px;height:135px;" src="https://via.placeholder.com/100x135?text=Book" alt="Cover" />
                    </div>
                    <div class="col-md-9">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">ISBN</dt>
                            <dd class="col-sm-8">978-0-123456-01-1</dd>
                            <dt class="col-sm-4">Category</dt>
                            <dd class="col-sm-8">Fiction</dd>
                            <dt class="col-sm-4">Author</dt>
                            <dd class="col-sm-8">J. Harmon</dd>
                            <dt class="col-sm-4">Publisher</dt>
                            <dd class="col-sm-8">Northfield Press</dd>
                            <dt class="col-sm-4">Publish Date</dt>
                            <dd class="col-sm-8">2021-03-14</dd>
                            <dt class="col-sm-4">Total Copies</dt>
                            <dd class="col-sm-8">6</dd>
                            <dt class="col-sm-4">Available Copies</dt>
                            <dd class="col-sm-8">4</dd>
                            <dt class="col-sm-4">Shelf Number</dt>
                            <dd class="col-sm-8">A-12</dd>
                        </dl>
                    </div>
                    <div class="col-12">
                        <p class="text-muted-sm mb-0">A quiet, atmospheric novel following a retired detective who notices things everyone else misses.</p>
                    </div>
                </div>

                <div class="form-section-title"><i class="bi bi-people"></i> Issued To Members</div>
                <div class="d-flex gap-2 flex-wrap">
                    <select class="form-select member-select-dropdown" data-link-id="viewMemberLink1" style="max-width: 320px;">
                        <option data-member-hash="member-1">Amanpreet Kaur — Issued 2026-07-01</option>
                        <option data-member-hash="member-2">Rohit Sharma — Returned 2026-05-20</option>
                    </select>
                    <a href="members.html#member-1" id="viewMemberLink1" class="btn btn-outline-secondary text-nowrap">
                        <i class="bi bi-box-arrow-up-right"></i> View Member
                    </a>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <a href="book-form.html" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
            </div>
        </div>
    </div>
</div>