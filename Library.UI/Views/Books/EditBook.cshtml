@model EditBookDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Add / Edit Book</h1>
    </div>

    <div class="panel">
        <div class="panel-body">
            <form asp-controller="Books" asp-action="EditBook" method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" value="@Model.Title" class="form-control" placeholder="e.g. The Silent Observer" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ISBN" class="form-label">ISBN</label>
                        <input type="text" class="form-control" placeholder="e.g. 978-0-123456-01-1" value="@Model.ISBN" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">Category</label>
                        <select asp-for="CategoryId" class="form-select">
                            @await Component.InvokeAsync("CategoryDropdown")
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AuthorId" class="form-label">Author</label>
                        <select asp-for="AuthorId" class="form-select">
                            @await Component.InvokeAsync("AuthorDropdown")
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Publisher" class="form-label">Publisher</label>
                        <input asp-for="Publisher" value="@Model.Publisher" class="form-control" placeholder="e.g. Northfield Press" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PublishDate" class="form-label">Publish Date</label>
                        <input asp-for="PublishDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TotalCopies" class="form-label">Total Copies</label>
                        <input asp-for="TotalCopies" value="@Model.TotalCopies" class="form-control" min="0" placeholder="0" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AvailableCopies" class="form-label">Available Copies</label>
                        <input asp-for="AvailableCopies" value="@Model.AvailableCopies" class="form-control" min="0" placeholder="0" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ShelfNumber" class="form-label">Shelf Number</label>
                        <input asp-for="ShelfNumber" value="@Model.ShelfNumber" class="form-control" placeholder="e.g. A-12" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" value
                        ="@Model.Description" class="form-control" rows="4" placeholder="Short description of the book..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ImageFileName" class="form-label">Cover Image</label>
                        <input asp-for="ImageFileName" value="@Model.ImageFileName" type="file" class="form-control" accept="image/*" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                    <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i>Cancel</a>
                </div>
            </form>
        </div>
    </div>
</main>