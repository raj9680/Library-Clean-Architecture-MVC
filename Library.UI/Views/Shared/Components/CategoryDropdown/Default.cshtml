@using Library.Application.DTOs
@model List<BookCategoryDto>

<select name="searchByCategory" class="form-select form-select-sm" style="max-width: 180px;">
    <option value="">All Categories</option>

    @foreach (var category in Model)
    {
        if (category.Name == @ViewBag.SearchByCategory)
        {
            <option selected="selected" value="@category.Name">@category.Name</option>
        }
        else
        {
            <option value="@category.Name">@category.Name</option>
        }
    }
</select>