<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Library Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body data-page="dashboard">

    <header class="app-header">
        <div class="header-left d-flex align-items-center" style="gap: 10px;">
            <button type="button" id="sidebarToggleBtn" class="sidebar-toggle-btn" title="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>
            <div class="brand"><i class="bi bi-journal-bookmark-fill"></i> Library Management System</div>
        </div>
        <div class="header-right">
            <span class="user-name d-none d-sm-inline"><i class="bi bi-person-circle"></i> Admin User</span>
            <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-person-badge"></i> Profile</a>
            <a href="login.html" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right"></i> Logout</a>
        </div>
    </header>

    <div class="app-wrapper">
        <aside class="app-sidebar">
            <div class="nav-title">Main Menu</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" data-page="dashboard" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 icon"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-page="books" asp-controller="Books" asp-action="Index"><i class="bi bi-book icon"></i> Books</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-page="authors" asp-controller="Authors" asp-action="Index"><i class="bi bi-pencil-square icon"></i> Authors</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-page="categories" asp-controller="Categories" asp-action="Index"><i class="bi bi-folder icon"></i> Categories</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-page="members" asp-controller="Members" asp-action="Index"><i class="bi bi-people icon"></i> Members</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-page="issue-book" asp-controller="Books" asp-action="IssueBook"><i class="bi bi-box-arrow-right icon"></i> Issue Book</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-page="return-book" asp-controller="Books" asp-action="ReturnBook"><i class="bi bi-box-arrow-in-left icon"></i> Return Book</a>
                </li>
                <li class="nav-item"><a class="nav-link" data-page="profile" asp-controller="Profile" asp-action="Index"><i class="bi bi-gear icon"></i> Profile</a></li>
            </ul>
        </aside>

        @RenderBody()
    </div>

    <footer class="app-footer">
        <span>&copy; 2026 Library Management System. All rights reserved.</span>
        <span>Version 1.0.0</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js"></script>

    @RenderSection("scripts", required: false);

</body>
</html>
