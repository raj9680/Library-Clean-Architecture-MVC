@model IEnumerable<CategoryDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main-content" id="mainContent">
    <div class="page-header">
        <h1>Categories</h1>
        <a asp-controller="Categories" asp-action="AddCategory" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Category</a>
    </div>

    <form class="toolbar" asp-controller="Categories" asp-action="Index" method="get">
        <input type="search" name="searchByName" class="form-control form-control-sm" style="max-width: 280px;" value="@ViewBag.SearchBy" placeholder="Search categories..." />
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
        <a asp-controller="Categories" asp-action="Index">Clear Search</a>
    </form>
    @if (TempData["DeletedResult"] != null)
    {
        int deletedResult = Convert.ToInt32(TempData["DeletedResult"]);

        if (deletedResult == 457)
        {
            <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
                <strong>Unable to delete Category.</strong>
                This category cannot be deleted because it is associated to one or more book.

                <button type="button"class="btn-close" data-bs-dismiss="alert" aria-label="Close">
                </button>
            </div>
        }
        else if (deletedResult == 1)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <strong>Category deleted successfully.</strong>
                The category has been removed successfully.

                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
                </button>
            </div>
        }
        else if (deletedResult == 0)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <strong>Something went wrong.</strong>
                The category could not be deleted. Please try again.

                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
                </button>
            </div>
        }
    }

    <div class="panel">
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Books Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var category in Model)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>412</td>
                                <td class="action-icons">
                                    <a asp-controller="Categories" asp-action="EditCategory" asp-route-id="@category.Id" ><i class="bi bi-pencil"></i></a>
                                    <a asp-controller="Categories" asp-action="DeleteCategory" asp-route-id="@category.Id" class="btn-delete text-danger"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>